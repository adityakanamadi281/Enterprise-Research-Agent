# Copy this file to .env for Docker Compose. Never commit real values.
DATABASE_URL=sqlite:////data/atlas.db
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: protects every /v1 endpoint when set.
ATLAS_API_KEY=
# OpenAlex works without a key. Set this only if your OpenAlex account provides one.
OPENALEX_API_KEY=
RESEARCH_PROVIDER=openalex
OPENALEX_URL=https://api.openalex.org/works
# Fireworks powers research planning, embeddings, and evidence-grounded synthesis.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
FIREWORKS_EMBEDDING_MODEL=
# Upstash Redis caches external retrieval results. Both values are required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEARCH_CACHE_TTL_SECONDS=3600
# Qdrant Cloud stores Fireworks embedding vectors. Both values are required.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=atlas_evidence
# Tavily provides current web results for the research agent.
TAVILY_API_KEY=
