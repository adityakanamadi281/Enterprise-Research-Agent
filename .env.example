# Copy this file to .env for Docker Compose. Never commit real values.
# Note: Specific values in backend/.env will take precedence over this file.
DATABASE_URL=sqlite:////data/atlas.db
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional API Key protection for Atlas routes:
ATLAS_API_KEY=

# Academic Database Config (OpenAlex works without a key by default):
OPENALEX_API_KEY=
RESEARCH_PROVIDER=openalex
OPENALEX_URL=https://api.openalex.org/works

# Fireworks AI credentials for LLM actions and embeddings:
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v3p1
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b

# Groq AI credentials (optional alternative LLM):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Redis caches external search results:
REDIS_URL=redis://redis:6379/0
RESEARCH_CACHE_TTL_SECONDS=3600

# Qdrant Vector database stores Fireworks embedding vectors:
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=atlas_evidence

# Tavily provides web search results:
TAVILY_API_KEY=

# General Agent Behavior Configuration:
ATLAS_REUSE_THRESHOLD=0.78
ATLAS_MIN_REUSE_CHUNKS=3
ATLAS_OFFLINE_DEMO_MODE=false
